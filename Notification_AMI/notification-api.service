[Unit]
Description=OT-Micro Notification API
After=network.target elasticsearch.service
Requires=elasticsearch.service

[Service]
Type=simple

User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/Notification

Environment=CONFIG_FILE=/home/ubuntu/Notification/config.yaml

ExecStart=/home/ubuntu/Notification/venv/bin/python \
/home/ubuntu/Notification/notification_api.py

Restart=always
RestartSec=5

StandardOutput=append:/home/ubuntu/logs/notification-api.log
StandardError=append:/home/ubuntu/logs/notification-api.log

[Install]
WantedBy=multi-user.target
